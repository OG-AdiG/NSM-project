# === Ogólne ===
NODE_ENV=development

# === API (NestJS) ===
API_PORT=3001
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# === Web (Next.js) ===
NEXT_PUBLIC_API_URL=http://localhost:3001/api

# === PostgreSQL ===
POSTGRES_USER=nsm
POSTGRES_PASSWORD=nsm_dev_password
POSTGRES_DB=nsm
POSTGRES_PORT=5432
DATABASE_URL=postgresql://nsm:nsm_dev_password@localhost:5432/nsm?schema=public

# === Redis (BullMQ) ===
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# === MinIO / S3 (zdjęcia referencyjne, dokumenty) ===
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=nsm-files
S3_PUBLIC_BUCKET=nsm-portfolio
S3_FORCE_PATH_STYLE=true

# === Stripe (płatności / zadatki) ===
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
STRIPE_PUBLISHABLE_KEY=pk_test_xxx

# === E-mail (SMTP) ===
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_FROM="NSM Studio <noreply@localhost>"

# === iOS / APNs (później) ===
# APNS_KEY_ID=
# APNS_TEAM_ID=
# APNS_BUNDLE_ID=
# APNS_KEY_PATH=
