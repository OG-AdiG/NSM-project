{
  "name": "nsm-project",
  "private": true,
  "version": "0.1.0",
  "description": "System wspomagający obsługę klientów i usług studia tatuażu",
  "packageManager": "pnpm@10.6.1",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "pnpm -r --parallel --filter @nsm/api --filter @nsm/web run dev",
    "dev:api": "pnpm --filter @nsm/api dev",
    "dev:web": "pnpm --filter @nsm/web dev",
    "build": "pnpm -r --filter @nsm/api --filter @nsm/web run build",
    "lint": "pnpm -r --filter @nsm/api --filter @nsm/web run lint",
    "test": "pnpm -r --filter @nsm/api --filter @nsm/web run test",
    "db:generate": "pnpm --filter @nsm/api prisma:generate",
    "db:migrate": "pnpm --filter @nsm/api prisma:migrate",
    "db:studio": "pnpm --filter @nsm/api prisma:studio",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f"
  }
}
